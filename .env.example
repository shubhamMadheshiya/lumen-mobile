# Copy this file to .env and fill in your values.
# Expo exposes EXPO_PUBLIC_* variables to the app bundle at build time.

# URL of the Lumen API server (no trailing slash)
# Local dev (Android emulator):  http://10.0.2.2:3000/api/v1
# Local dev (iOS simulator):     http://localhost:3000/api/v1
# Local dev (physical device):   http://<your-machine-ip>:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Google OAuth client IDs — create at https://console.cloud.google.com/
# Under APIs & Services > Credentials > Create OAuth 2.0 Client ID
# You need a "Web application" client ID (used for Expo Go / web) and optionally
# separate Android and iOS client IDs for production builds.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
